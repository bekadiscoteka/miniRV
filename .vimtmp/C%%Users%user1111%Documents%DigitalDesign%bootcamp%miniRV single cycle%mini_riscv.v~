// mini risc-v single cycle version

module mini_riscv(
	output reg 	[31:0] 	dataMem_addr,
						dataMem_out,

	output wire [31:0] 	instr_addr,
	output reg			is_byte,
						dataMem_wre,

	input [31:0] 		instr,
						dataMem_in,
	input 				clk, reset
);
	localparam [6:0] 	ADDI=7'b0010011, JALR=7'b1100111,
						LUI=7'b0110111,
						LW=7'b0000011,
						ADD=7'b0110011,
						SW=7'b0100011;


	reg [31:0]	zero, ra, sp, gp, tp, 
				t0, t1, t2, 
				s0_fp, s1,  
				a0 ,a1, a2, a3, a4, a5,
				pc;

	reg [31:0] rs1_out, rs2_out;

	wire [6:0] opcode	= instr[6:0];
	wire [4:0] rd		= instr[11:7];
	wire [2:0] funct3	= instr[14:12];
	wire [4:0] rs1		= instr[19:15];
	wire [4:0] rs2		= instr[24:20];
	wire [11:0] immI	= instr[31:20];
	wire [19:0] immU 	= instr[31:12];
	wire [11:0] immS 	= {instr[31:25], instr[11:7]};
	assign instr_addr = pc;

	// rs1 mux 
	always @* begin
		case (rs1) 
			0: rs1_out = zero;
			1: rs1_out = ra;
			2: rs1_out = sp;
			3: rs1_out = gp;
			4: rs1_out = tp;
			5: rs1_out = t0; 
			6: rs1_out = t1;
			7: rs1_out = t2;
			8: rs1_out = s0_fp;
			9: rs1_out = s1;
			10: rs1_out = a0;
			11: rs1_out = a1;
			12: rs1_out = a2;
			13: rs1_out = a3;
			14: rs1_out = a4;
			15: rs1_out = a5;
			default: rs1_out = 0;
		endcase
	end

	// rs2 mux
	always @* begin
		case (rs2) 
			0: rs2_out = zero;
			1: rs2_out = ra;
			2: rs2_out = sp;
			3: rs2_out = gp;
			4: rs2_out = tp;
			5: rs2_out = t0; 
			6: rs2_out = t1;
			7: rs2_out = t2;
			8: rs2_out = s0_fp;
			9: rs2_out = s1;
			10: rs2_out = a0;
			11: rs2_out = a1;
			12: rs2_out = a2;
			13: rs2_out = a3;
			14: rs2_out = a4;
			15: rs2_out = a5;
			default: rs2_out = 0;
		endcase
	end

	always @(posedge clk, posedge reset) begin
		if (reset) begin
			zero<=0; ra<=0; sp<=0; gp<=0; tp<=0; 
			t0<=0; t1<=0; t2<=0; 
			s0_fp<=0; s1<=0;  
			a0<=0;a1<=0; a2<=0; a3<=0; a4<=0; a5<=0;
			pc<=0;

		end
		else begin
			case (opcode) 
				ADDI: begin
					if (immI[11])	set_rd( { {20{1'b1}}, immI } + rs1_out );
					else 			set_rd( { {20{1'b0}}, immI } + rs1_out );

					pc <= pc + 4;
				end
				ADD: begin
					set_rd(rs1_out + rs2_out);

					pc <= pc + 4;
				end
				LUI: begin
					set_rd( {immU, { 12{1'b0} }} );

					pc <= pc + 4;
				end
				JALR: begin
					set_rd(pc + 4);
					if (immI[11])	pc <= ( rs1_out + { {20{ 1'b1 }}, immI } ) & ~32'd1;
					else			pc <= ( rs1_out + { {20{ 1'b0 }}, immI } ) & ~32'd1;
				end
				LW: begin
					case (funct3) 
						3'b100: set_rd( {24'd0, dataMem_in[7:0]} );
						default: set_rd( dataMem_in );
					endcase

					pc <= pc + 4;
				end
				SW: begin

					pc <= pc + 4;		
				end
				default: pc <= pc + 4;
			endcase
		end
	end

	always @* begin
		case (opcode) 
			LW: begin
				if (immI[11]) begin
					dataMem_addr = rs1_out + { {20{ 1'b1 }}, immI };
				end
				else begin
					dataMem_addr = rs1_out + { {20{ 1'b0 }}, immI};
				end
			end
			SW: begin
				if (immS[11]) begin
					dataMem_addr = rs1_out + { {20{ 1'b1 }}, immS };
				end
				else begin
					dataMem_addr = rs1_out + { {20{ 1'b0 }}, immS};
				end
				dataMem_wre = 1;
				dataMem_out = rs2_out;

				case (funct3) 
					3'b000: is_byte = 1;
					default: is_byte = 0;
				endcase
			end
			default: begin
				dataMem_addr = 0;
				dataMem_wre = 0;
				dataMem_out = 0;
				is_byte = 0;
			end
		endcase
	end


	task set_rd(input [31:0] value);
		begin
			case (rd) 
				//0: zero <= value;
				1: ra <= value;
				2: sp <= value;
				3: gp <= value;
				4: tp <= value;
				5: t0 <= value; 
				6: t1 <= value;
				7: t2 <= value;
				8: s0_fp <= value;
				9: s1 <= value;
				10: a0 <= value;
				11: a1 <= value;
				12: a2 <= value;
				13: a3 <= value;
				14: a4 <= value;
				15: a5 <= value;
			endcase
		end
	endtask
endmodule
