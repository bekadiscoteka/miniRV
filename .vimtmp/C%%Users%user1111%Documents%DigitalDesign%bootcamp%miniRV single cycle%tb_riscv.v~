`include "ROM32x32.v"
`include "RAM32x32.v"
`include "mini_riscv.v"

module tb_riscv;
	reg clk=0, reset=0;

	wire [31:0]	data,
				data_out,
				data_addr,
				
				instr,
				instr_addr;
	wire rde, wre, is_byte; 
				
	ROM32x32 instrMem(
		.data_out(instr),
		.address(instr_addr)
	);

	RAM32x32 dataMem(
		.data_in(data_out),
		.data_out(data),	

		.wre(wre),
		.address(data_addr),
		.clk(clk),
		.reset(reset),

		.is_byte(is_byte)
	);	

	mini_riscv cpu(
		.dataMem_addr(data_addr),
		.dataMem_wre(wre),
		.is_byte(is_byte),

		.instr(instr),
		.instr_addr(instr_addr),

		.clk(clk),
		.reset(reset),
		.dataMem_in(data),
		.dataMem_out(data_out)
	);
