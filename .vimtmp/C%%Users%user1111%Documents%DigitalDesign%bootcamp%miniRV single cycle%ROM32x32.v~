module ROM32x32 (
    input  wire [31:0] address,
    output wire [31:0] data_out
);

    reg [7:0] mem [0:16777215];

    wire [23:0] addr = address[23:0];

	assign data_out = {
		mem[addr + 3],
		mem[addr + 2],
		mem[addr + 1],
		mem[addr + 0]
   	};

	integer i;
	initial begin 
        $readmemh("test_programs/sum.hex", mem);
		for (i = 0; i<=65_535; i=i+1) begin
			if (mem[i] === 8'bx) mem[i] = 0;
		end
		$display("mem max: %d", mem[65_535]);
    end

endmodule
